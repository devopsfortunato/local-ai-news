    {
      "kicker": "Official",
      "title": "Hugging Face blog: ViKernel wires an operating system inside the model file",
      "summary": "ViKernel / VIDRAFT is a weight-native OS design that puts ROM, RAM and an xPU-style control circuit directly into the model file, with an in-model kill switch, boot integrity state and a non-editable audit chain instead of external wrappers and prompt filters. A public demo is available at FINAL-Bench/ViKernel-Desktop.",
      "source": "Hugging Face",
      "date": "2026-11-01",
      "url": "https://huggingface.co/blog/FINAL-Bench/vikernel-why-the-kill-switch-must-live-inside-the",
      "scout_source": "official"
    },
    {
      "kicker": "Runtimes",
      "title": "llama.cpp b12034 lands with WebGPU scratch-allocation fix and new OpenCL IQ3 support",
      "summary": "The Nov 2 build keeps scratch allocation sizes monotonic in batch length for the flash-attention vec and MMVQ paths. The Nov 1 batch (b12029-b12032) added initial IQ3 OpenCL support, a PkgConfig path for LevelZero SYCL includes and a Hexagon DMA stride fix.",
      "source": "GitHub",
      "date": "2026-11-02",
      "url": "https://github.com/ggml-org/llama.cpp/releases/tag/b12034",
      "scout_source": "tools"
    },
    {
      "kicker": "Edge hardware",
      "title": "DGX Spark benchmark roundup: MoE is the sweet spot on GB10",
      "summary": "An aggregated measurement table shows the DGX Spark at ~59 tok/s on gpt-oss-120b at low context in llama.cpp, with dense 70B models under 5 tok/s; software updates moved scores more than partner-board differences. Two clustered 64GB units reach up to 1.7x single-unit performance via NVIDIA Sync.",
      "source": "Verdict Bits",
      "date": "2026-11-01",
